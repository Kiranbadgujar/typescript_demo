{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    // "rootDir": "./src",
    "paths": {
      "@config/*": ["config/*"],
      "@controller/*": ["controller/*"],
      "@routes/*": ["Routes/*"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "node_modules/@types/**/*"
  ],
  "exclude": [
    "node_modules",
  ]
}
